# Exact frontend origins; no paths, wildcards, or trailing slash.
# Required in production. Development defaults to http://localhost:3000.
FRONTEND_ORIGINS=http://localhost:3000

# Clerk application keys. Copy real values from your Clerk dashboard; never commit them.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon pooled connection used only by the running application.
DATABASE_URL=

# Neon direct connection used only by controlled release migrations and backups.
DIRECT_URL=

# Neon CLI writes this equivalent direct URL. `DIRECT_URL` takes precedence.
DATABASE_URL_UNPOOLED=

# Trigger.dev secret for durable run dispatch. Leave empty until a real project key exists.
# The key is server-only. Never commit a value or expose it to the browser.
TRIGGER_SECRET_KEY=

# Server-only OpenRouter credential. Leave empty until a real key exists.
# The execution loop requests only openrouter/free and rejects every other configured model.
# Never commit a value or expose it to the browser.
OPENROUTER_API_KEY=

# Optional. Unset means openrouter/free. Any other value disables model execution.
OPENROUTER_MODEL=

# Optional maximum model turns for one run. Unset uses the conservative default of 4.
# Allowed range is 1 through 8. There is no stale-lock timeout in this service.
AGENT_MAX_TURNS=
