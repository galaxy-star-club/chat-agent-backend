{
  "name": "@agentic-chat/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:trigger": "trigger dev",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:export": "node scripts/export-contracts.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@trigger.dev/sdk": "4.8.3",
    "next": "16.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.8.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "trigger.dev": "4.8.3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.2"
}
