# Exact frontend origins; no paths, wildcards, or trailing slash.
# Required in production. Development defaults to http://localhost:3000.
FRONTEND_ORIGINS=http://localhost:3000

# Clerk application keys. Copy real values from your Clerk dashboard; never commit them.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon pooled connection used only by the running application.
DATABASE_URL=

# Neon direct connection used only by controlled release migrations and backups.
DIRECT_URL=

# Neon CLI writes this equivalent direct URL. `DIRECT_URL` takes precedence.
DATABASE_URL_UNPOOLED=


# Optional. Unset means openrouter/free. Any other value disables model execution.
OPENROUTER_MODEL=

# Optional maximum model turns for one run. Unset uses the default of 8.
# Allowed range is 1 through 8. There is no stale-lock timeout in this service.
AGENT_MAX_TURNS=

# Optional Magica video tools. Keep these server-only and set them only in the backend/Trigger deployment.
# Tool node IDs stay configurable because Magica's catalog can change.
MAGICA_API_KEY=
MAGICA_BASE_URL=https://inference.magica.com
MAGICA_VIDEO_BACKGROUND_REMOVER_NODE=
MAGICA_VIDEO_UPSCALER_NODE=

# Transloadit Community uploads. The Auth Secret stays on the backend and Trigger.dev only.
TRANSLOADIT_KEY=
TRANSLOADIT_SECRET=
TRANSLOADIT_TEMPLATE_ID=
# Use the algorithm selected when creating the Auth Key. Smart CDN credentials require sha256.
TRANSLOADIT_SIGNATURE_ALGORITHM=sha384
